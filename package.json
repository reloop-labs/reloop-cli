{
	"name": "reloop-cli",
	"version": "0.1.0",
	"description": "The official CLI for Reloop — open-source email infrastructure",
	"type": "module",
	"bin": {
		"reloop": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bun src/index.ts",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"reloop",
		"cli",
		"email",
		"contacts",
		"transactional-email"
	],
	"author": "Reloop Labs",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reloop-labs/reloop-cli.git"
	},
	"homepage": "https://github.com/reloop-labs/reloop-cli#readme",
	"bugs": {
		"url": "https://github.com/reloop-labs/reloop-cli/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@types/bun": "^1.3.14",
		"@types/node": "^20.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.9.2"
	}
}
